rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }

    function email() {
      return request.auth.token.email.lower();
    }

    function memberPath(companyId) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(email());
    }

    function isMember(companyId) {
      return signedIn() && exists(memberPath(companyId));
    }

    function member(companyId) {
      return get(memberPath(companyId)).data;
    }

    function role(companyId) {
      return isMember(companyId) ? member(companyId).role : null;
    }

    function ownerOrAdmin(companyId) {
      return role(companyId) in ['owner', 'admin'];
    }

    function fullDataRole(companyId) {
      return role(companyId) in ['owner', 'admin', 'manager', 'accountant'];
    }

    function supervisor(companyId) {
      return role(companyId) == 'supervisor';
    }

    function worker(companyId) {
      return role(companyId) == 'worker';
    }

    function viewer(companyId) {
      return role(companyId) == 'viewer';
    }

    function sameCompany(companyId) {
      return request.resource.data.companyId == companyId;
    }

    function hasAssignedProjects(companyId) {
      return member(companyId).assignedProjectIds is list;
    }

    function hasAssignedWorkers(companyId) {
      return member(companyId).assignedWorkerIds is list;
    }

    function assignedProject(companyId, projectId) {
      return hasAssignedProjects(companyId) && projectId is string && projectId in member(companyId).assignedProjectIds;
    }

    function assignedWorker(companyId, workerId) {
      return hasAssignedWorkers(companyId) && workerId is string && workerId in member(companyId).assignedWorkerIds;
    }

    function canReadProjectDoc(companyId) {
      return fullDataRole(companyId)
        || ((supervisor(companyId) || viewer(companyId)) && assignedProject(companyId, resource.data.projectId));
    }

    function canReadProjectOrWorkerDoc(companyId) {
      return fullDataRole(companyId)
        || ((supervisor(companyId) || viewer(companyId)) && assignedProject(companyId, resource.data.projectId))
        || (worker(companyId) && assignedWorker(companyId, resource.data.workerId));
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow create, update, delete: if ownerOrAdmin(companyId);

      match /members/{memberId} {
        allow read: if ownerOrAdmin(companyId) || memberId == email();
        allow write: if ownerOrAdmin(companyId);
      }

      match /transactions/{docId} {
        allow read: if canReadProjectDoc(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /sites/{docId} {
        allow read: if fullDataRole(companyId)
          || ((supervisor(companyId) || worker(companyId) || viewer(companyId)) && assignedProject(companyId, docId));
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /workers/{docId} {
        allow read: if fullDataRole(companyId)
          || (supervisor(companyId) && (assignedWorker(companyId, docId) || assignedProject(companyId, resource.data.projectId)))
          || (worker(companyId) && assignedWorker(companyId, docId));
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /materials/{docId} {
        allow read: if canReadProjectDoc(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /bills/{docId} {
        allow read: if canReadProjectDoc(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /reminders/{docId} {
        allow read: if fullDataRole(companyId)
          || ((supervisor(companyId) || viewer(companyId) || worker(companyId)) && assignedProject(companyId, resource.data.projectId));
        allow write: if sameCompany(companyId)
          && (fullDataRole(companyId)
            || ((supervisor(companyId) || worker(companyId)) && assignedProject(companyId, request.resource.data.projectId)));
      }

      match /dailyReports/{docId} {
        allow read: if canReadProjectOrWorkerDoc(companyId);
        allow create, update: if sameCompany(companyId)
          && (fullDataRole(companyId)
            || (supervisor(companyId) && assignedProject(companyId, request.resource.data.projectId))
            || (worker(companyId) && assignedWorker(companyId, request.resource.data.workerId)));
        allow delete: if ownerOrAdmin(companyId);
      }

      match /accounts/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if ownerOrAdmin(companyId) && sameCompany(companyId);
      }

      match /journal/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /ledger/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /customers/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /suppliers/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /invoices/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /supplierBills/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /purchaseOrders/{docId} {
        allow read: if fullDataRole(companyId);
        allow write: if fullDataRole(companyId) && sameCompany(companyId);
      }

      match /attendance/{docId} {
        allow read: if fullDataRole(companyId)
          || (supervisor(companyId) && assignedProject(companyId, resource.data.siteId))
          || (worker(companyId) && resource.data.workerId == member(companyId).workerId);
        allow write: if sameCompany(companyId)
          && (fullDataRole(companyId)
            || (supervisor(companyId) && assignedProject(companyId, request.resource.data.siteId)));
      }

      match /payrollRuns/{docId} {
        allow read: if fullDataRole(companyId)
          || (worker(companyId) && resource.data.workerId == member(companyId).workerId);
        allow write: if ownerOrAdmin(companyId) && sameCompany(companyId);
      }

      match /invites/{inviteId} {
        allow read: if ownerOrAdmin(companyId);
        allow create, update, delete: if ownerOrAdmin(companyId);
      }

      match /auditLogs/{docId} {
        allow read: if ownerOrAdmin(companyId);
        allow create: if isMember(companyId);
        allow update, delete: if false;
      }
    }

    match /wallets/{walletId} {
      allow read, write: if signedIn() && walletId == email();
    }

    // Prevent client access to companyOwners index used by server-side owner
    // uniqueness enforcement. Only server Admin SDK should write/read these.
    match /companyOwners/{ownerId} {
      // Deny all client reads and writes. Admin SDK bypasses rules.
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Protect securityEvents used for server-side rate-limiting and alerts.
    // Deny all client access; only server Admin SDK may read/write these.
    match /securityEvents/{document=**} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}
