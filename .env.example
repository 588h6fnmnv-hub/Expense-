# Google login.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
NEXTAUTH_SECRET=REPLACE_WITH_NEXTAUTH_SECRET
NEXTAUTH_URL=http://localhost:3004
# Production must be https://your-domain.com

# Firebase web app config for Firestore wallet storage.
NEXT_PUBLIC_FIREBASE_API_KEY=REPLACE_WITH_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=REPLACE_WITH_FIREBASE_AUTH_DOMAIN
NEXT_PUBLIC_FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=REPLACE_WITH_FIREBASE_STORAGE_BUCKET
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=REPLACE_WITH_FIREBASE_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=REPLACE_WITH_FIREBASE_APP_ID
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=REPLACE_WITH_FIRESTORE_DATABASE_ID

# Firebase Admin SDK values. Server-only. Never prefix with NEXT_PUBLIC_.
FIREBASE_PROJECT_ID=REPLACE_WITH_FIREBASE_PROJECT_ID
FIREBASE_CLIENT_EMAIL=REPLACE_WITH_FIREBASE_CLIENT_EMAIL
FIREBASE_PRIVATE_KEY="REPLACE_WITH_FIREBASE_PRIVATE_KEY_WITH_ESCAPED_NEWLINES"

# Production backend values to add later.
# OUTLOOK_CLIENT_ID=
# OUTLOOK_CLIENT_SECRET=
# OCR_PROVIDER_API_KEY=
# BANK_FEED_PROVIDER_KEY=
# EXCHANGE_RATE_API_KEY=
